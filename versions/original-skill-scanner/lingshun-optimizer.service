[Unit]
Description=Lingshun Skill Scanner Optimizer
After=network.target

[Service]
Type=simple
User=cdy
WorkingDirectory=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode
ExecStart=/usr/bin/python3 /home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/lingshun_optimizer.py --daemon --interval 300
Restart=on-failure
RestartSec=10

# 凌晨复活配置
# 每天 6:00 自动复活检查

[Install]
WantedBy=multi-user.target
