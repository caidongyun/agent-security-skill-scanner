[Unit]
Description=Lingshun Security Daemon
After=network.target

[Service]
Type=forking
User=cdy
WorkingDirectory=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode
ExecStart=/usr/bin/python3 /home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/round14/lingshun_daemon.py start
ExecStop=/usr/bin/python3 /home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/round14/lingshun_daemon.py stop
ExecReload=/usr/bin/python3 /home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/round14/lingshun_daemon.py restart
PIDFile=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/.lingshun.pid
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lingshun

# 安全限制
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/logs
ReadWritePaths=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/samples
ReadWritePaths=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/rules

# 资源限制
LimitNOFILE=65535
LimitNPROC=4096
MemoryMax=2G

[Install]
WantedBy=multi-user.target
