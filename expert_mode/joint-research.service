[Unit]
Description=灵顺 V5 + agent-defender 联合持续研发系统
After=network.target

[Service]
Type=simple
User=cdy
Group=cdy
WorkingDirectory=/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode
ExecStart=/usr/bin/python3 /home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/joint_research.py --interval 300
Restart=always
RestartSec=10
StandardOutput=append:/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/logs/joint_research.log
StandardError=append:/home/cdy/.openclaw/workspace/skills/agent-security-skill-scanner/expert_mode/logs/joint_research.log

# 环境变量
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# 资源限制
LimitNOFILE=65535
Nice=10

[Install]
WantedBy=multi-user.target
