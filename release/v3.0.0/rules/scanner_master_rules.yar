        mitre_id = "ATLAS-T0005"
    strings:
        $curl = /curl\s+.*\|\s*(bash|sh)/
        $http = /https?:\/\/[^\s"']+/
    condition:
        $curl and $http
}

rule Agent_Env_Theft {
