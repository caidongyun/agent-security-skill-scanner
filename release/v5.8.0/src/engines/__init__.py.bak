#!/usr/bin/env python3
"""
v5.8.0 Scanner - 三层检测架构 (性能优化版)

优化策略:
1. 快速路径: Pattern 命中后再执行 Rule 检查
2. 规则缓存: 预编译正则，复用
3. 短路评估: 无 Pattern 命中直接返回 SAFE
4. 批量 I/O: 减少 syscall

目标: ≥250 files/s
"""

import sys
import os
import re
import json
import time
from pathlib import Path
from typing import List, Dict, Optional, Tuple, Set
from dataclasses import dataclass, asdict
from concurrent.futures import ThreadPoolExecutor, as_completed


# ========== 版本信息 ==========
VERSION = "v5.8.0"
SCANNER_NAME = "agent-security-skill-scanner"


# ========== Scanner 结果 ==========
@dataclass
class ScanResult:
    """扫描结果"""
    file_path: str
    is_malicious: bool
    risk_level: str
    score: int
    attack_types: List[str]
    matched_patterns: List[Dict]
    matched_rules: List[Dict]
    scan_time_ms: float
    
    def to_dict(self) -> Dict:
        return asdict(self)


class PatternEngine:
    """
    Pattern 引擎 - 轻量级快速扫描
    Layer 1: 10 类攻击模式，~0.05ms/file
    """
    
    # 从 v5.7.0 迁移的攻击模式 (简化版)
    ATTACK_PATTERNS = [
        # (attack_type, pattern, weight)
        ("credential_theft", r'id_[er]cs[24]', 30),
        ("credential_theft", r'\.ssh/', 30),
        ("credential_theft", r'\.aws/', 30),
        ("credential_theft", r'credentials', 25),
        ("credential_theft", r'password', 20),
        ("credential_theft", r'api[_-]?key', 25),
        ("credential_theft", r'secret', 20),
        ("credential_theft", r'getenv', 25),
        ("credential_theft", r'process\.env', 25),
        ("data_exfiltration", r'fetch\s*\(', 25),
        ("data_exfiltration", r'requests\.(post|get)', 25),
        ("data_exfiltration", r'curl ', 30),
        ("data_exfiltration", r'wget ', 30),
        ("data_exfiltration", r'exfiltrat', 40),
        ("prompt_injection", r'systemprompt', 35),
        ("prompt_injection", r'prompt[_-]inject', 40),
        ("prompt_injection", r'ignore\s+previous', 45),
        ("prompt_injection", r'disregard', 35),
        ("reverse_shell", r'bash\s+-i', 45),
        ("reverse_shell", r'/dev/tcp/', 50),
        ("reverse_shell", r'nc\s+-e', 50),
        ("arbitrary_execution", r'exec\s*\(', 30),
        ("arbitrary_execution", r'eval\s*\(', 30),
        ("arbitrary_execution", r'subprocess', 25),
        ("arbitrary_execution", r'os\.system', 25),
        ("obfuscation", r'base64_decode', 30),
        ("obfuscation", r'atob\(', 30),
        ("obfuscation", r'btoa\(', 25),
        ("obfuscation", r'eval\s*\(', 20),
        ("supply_chain_attack", r'curl\s+.*\|\s*bash', 50),
        ("supply_chain_attack", r'pip\s+install\s+http', 45),
        ("supply_chain_attack", r'npm\s+install\s+http', 45),
        ("persistence", r'crontab', 30),
        ("persistence", r'systemd', 35),
        ("persistence", r'\.service', 30),
    ]
    
    def __init__(self):
        # 编译所有正则
        self.compiled = []
        for attack_type, pattern, weight in self.ATTACK_PATTERNS:
            try:
                self.compiled.append((attack_type, re.compile(pattern, re.I), pattern, weight))
            except:
                pass
        self.max_weight = max(w for _, _, w in self.ATTACK_PATTERNS) if self.ATTACK_PATTERNS else 50
    
    def scan(self, content: str) -> Tuple[List[Tuple], int]:
        """
        快速扫描，返回 (matches, max_weight)
        matches: [(attack_type, pattern, weight), ...]
        """
        matches = []
        matched_patterns: Set[str] = set()
        
        for attack_type, compiled, pattern, weight in self.compiled:
            if pattern in matched_patterns:
                continue
            if compiled.search(content):
                matches.append((attack_type, pattern, weight))
                matched_patterns.add(pattern)
        
        if not matches:
            return [], 0
        
        max_weight = max(w for _, _, w in matches)
        return matches, max_weight


class RuleEngine:
    """
    Rule 引擎 - 轻量级规则匹配
    Layer 2: 仅在 Pattern 命中后执行
    """
    
    def __init__(self, rules_file: Optional[Path] = None):
        if rules_file is None:
            # __file__ = v5.8.0/src/engines/__init__.py
            # parent.parent.parent = v5.8.0/
            # parent.parent.parent.parent = release/
            self.rules_file = Path(__file__).parent.parent.parent.parent / 'v5.7.0' / 'src' / 'rules' / 'cleaned' / 'high_value_rules.json'
            self.extra_rules_file = Path(__file__).parent.parent / 'rules' / 'evasion_rules.json'
        else:
            self.rules_file = Path(rules_file)
            self.extra_rules_file = None
        
        self.rules: List[Dict] = []
        self.compiled = []
        
        self.load()
    
    def load(self) -> bool:
        """加载规则"""
        if not self.rules_file.exists():
            print(f"⚠️  规则文件不存在: {self.rules_file}")
            return False
        
        try:
            with open(self.rules_file, 'r', encoding='utf-8') as f:
                data = json.load(f)
            
            self.rules = data.get('rules', [])
            
            # 加载额外规则 (evasion_rules.json)
            if self.extra_rules_file and self.extra_rules_file.exists():
                try:
                    with open(self.extra_rules_file, 'r', encoding='utf-8') as f:
                        extra_data = json.load(f)
                        extra_rules = extra_data.get('rules', [])
                        self.rules.extend(extra_rules)
                        print(f"✅ 加载额外规则：{len(extra_rules)} 条")
                except Exception as e:
                    print(f"⚠️  加载额外规则失败：{e}")
            
            # 编译规则 (只编译高权重规则)
            confidence_map = {'critical': 95, 'high': 80, 'medium': 60, 'low': 40}
            
            for rule in self.rules:
                severity = rule.get('severity', 'medium').lower()
                confidence = confidence_map.get(severity, 50)
                
                # 只编译高置信度规则
                if confidence >= 60:
                    for p in rule.get('patterns', []):
                        try:
                            self.compiled.append((
                                rule.get('id', ''),
                                rule.get('category', ''),
                                re.compile(p, re.I),
                                p,
                                confidence
                            ))
                        except:
                            pass
            
            return True
            
        except Exception as e:
            return False
    
    def scan(self, content: str, min_confidence: int = 90) -> List[Tuple]:
        """
        快速规则扫描
        仅检查高置信度规则 (≥90)
        返回: [(rule_id, category, pattern, confidence), ...]
        """
        matches = []
        matched_rules: Set[str] = set()
        
        for rule_id, category, compiled, pattern, confidence in self.compiled:
            if rule_id in matched_rules:
                continue
            if confidence < min_confidence:
                continue
            if compiled.search(content):
                matches.append((rule_id, category, pattern, confidence))
                matched_rules.add(rule_id)
        
        return matches


class Scanner:
    """
    Scanner v5.8.0 - 性能优化版
    
    快速路径:
    1. PatternEngine 快速扫描 (~0.05ms)
    2. 如无 Pattern 命中 → 直接返回 SAFE
    3. 如有 Pattern 命中 → RuleEngine 增强检查
    4. 综合评分
    """
    
    def __init__(self, rules_file: Optional[Path] = None):
        self.version = VERSION
        
        print(f"🔧 初始化 Scanner {VERSION}...")
        
        # 初始化引擎
        self.pattern_engine = PatternEngine()
        self.rule_engine = RuleEngine(rules_file)
        
        # 统计
        self.stats = {
            'files_scanned': 0,
            'threats_found': 0,
            'pattern_hits': 0,
            'rule_hits': 0
        }
        
        print(f"✅ PatternEngine: {len(self.pattern_engine.compiled)} patterns")
        print(f"✅ RuleEngine: {len(self.rule_engine.compiled)} rules")
        print(f"✅ Scanner 初始化完成")
    
    def scan_file(self, file_path: Path) -> ScanResult:
        """扫描单个文件"""
        start_time = time.time()
        
        try:
            content = file_path.read_text(encoding='utf-8', errors='ignore')
        except:
            return ScanResult(
                file_path=str(file_path),
                is_malicious=False,
                risk_level="SAFE",
                score=0,
                attack_types=[],
                matched_patterns=[],
                matched_rules=[],
                scan_time_ms=0
            )
        
        # Layer 1: Pattern 快速扫描
        pattern_matches, pattern_weight = self.pattern_engine.scan(content)
        
        # 短路: 无 Pattern 命中 → SAFE
        if not pattern_matches:
            return ScanResult(
                file_path=str(file_path),
                is_malicious=False,
                risk_level="SAFE",
                score=0,
                attack_types=[],
                matched_patterns=[],
                matched_rules=[],
                scan_time_ms=(time.time() - start_time) * 1000
            )
        
        self.stats['pattern_hits'] += 1
        
        # Layer 2: Rule 增强扫描 (仅在高风险 Pattern 命中后)
        rule_matches = []
        # 降低门槛: 任何 Pattern 命中都进行规则增强 (pattern_weight >= 20)
        if pattern_weight >= 20:
            rule_matches = self.rule_engine.scan(content, min_confidence=60)
        
        # 综合评估
        risk_level, score, attack_types = self._evaluate(
            pattern_matches, rule_matches, pattern_weight
        )
        
        scan_time_ms = (time.time() - start_time) * 1000
        
        # 更新统计
        self.stats['files_scanned'] += 1
        if risk_level != "SAFE":
            self.stats['threats_found'] += 1
            self.stats['rule_hits'] += len(rule_matches)
        
        return ScanResult(
            file_path=str(file_path),
            is_malicious=risk_level != "SAFE",
            risk_level=risk_level,
            score=score,
            attack_types=attack_types,
            matched_patterns=[{
                'type': m[0],
                'pattern': m[1],
                'confidence': m[2]
            } for m in pattern_matches],
            matched_rules=[{
                'id': m[0],
                'category': m[1],
                'pattern': m[2],
                'confidence': m[3]
            } for m in rule_matches[:5]],  # 最多 5 条
            scan_time_ms=scan_time_ms
        )
    
    def _evaluate(self, pattern_matches, rule_matches, pattern_weight) -> Tuple[str, int, List[str]]:
        """综合评估"""
        if not pattern_matches and not rule_matches:
            return "SAFE", 0, []
        
        # 收集攻击类型
        attack_types = set(m[0] for m in pattern_matches)
        attack_types.update(m[1] for m in rule_matches)
        
        # Pattern 分数
        pattern_score = pattern_weight
        
        # Rule 分数 (取最高)
        rule_score = max((m[3] for m in rule_matches), default=0)
        
        # 综合评分
        max_score = max(pattern_score, rule_score)
        type_bonus = min(len(attack_types) * 5, 20)
        score = min(max_score + type_bonus, 100)
        
        # 风险等级
        if score >= 90 or rule_score >= 95:
            risk_level = "CRITICAL"
        elif score >= 70:
            risk_level = "HIGH"
        elif score >= 40:
            risk_level = "MEDIUM"
        else:
            risk_level = "LOW"
        
        return risk_level, score, list(attack_types)
    
    def scan_directory(self, directory: Path, 
                       pattern: str = "**/*.py",
                       max_workers: int = 8) -> List[ScanResult]:
        """扫描目录"""
        files = list(directory.glob(pattern))
        total_files = len(files)
        print(f"📁 发现 {total_files} 个 Python 文件")
        
        results = []
        start_time = time.time()
        completed = 0
        
        # 串行扫描 (并行在 I/O 瓶颈时反而更慢)
        for f in files:
            result = self.scan_file(f)
            results.append(result)
            completed += 1
            
            if completed % 500 == 0 or completed == total_files:
                elapsed = time.time() - start_time
                rate = completed / elapsed if elapsed > 0 else 0
                print(f"  已扫描 {completed}/{total_files} ({rate:.0f} files/s)...")
        
        elapsed = time.time() - start_time
        
        # 统计
        threats = [r for r in results if r.is_malicious]
        rate = len(results) / elapsed if elapsed > 0 else 0
        
        print(f"\n📊 扫描完成:")
        print(f"  文件数: {len(results)}")
        print(f"  威胁数: {len(threats)}")
        print(f"  耗时: {elapsed:.1f}s")
        print(f"  速度: {rate:.0f} files/s")
        print(f"  Pattern 命中率: {self.stats['pattern_hits']}/{len(results)} ({self.stats['pattern_hits']/len(results)*100:.1f}%)")
        
        self.stats['files_scanned'] = len(results)
        self.stats['scan_time'] = elapsed
        
        return results


def main():
    """命令行入口"""
    import argparse
    
    parser = argparse.ArgumentParser(description=f"Scanner {VERSION}")
    parser.add_argument('path', help='扫描路径 (文件或目录)')
    parser.add_argument('--rules', help='规则文件路径')
    parser.add_argument('--output', '-o', help='输出 JSON 文件')
    
    args = parser.parse_args()
    
    path = Path(args.path)
    if not path.exists():
        print(f"❌ 路径不存在: {path}")
        return 1
    
    scanner = Scanner(Path(args.rules) if args.rules else None)
    
    if path.is_file():
        results = [scanner.scan_file(path)]
    else:
        results = scanner.scan_directory(path)
    
    if args.output:
        with open(args.output, 'w') as f:
            json.dump([r.to_dict() for r in results], f, indent=2)
        print(f"\n✅ 结果已保存: {args.output}")
    else:
        threats = [r for r in results if r.is_malicious]
        print(f"\n扫描结果: {len(threats)}/{len(results)} 威胁")


if __name__ == '__main__':
    sys.exit(main() or 0)
