#!/bin/bash
# Scanner Master v3.0 - 统一安全扫描入口
# 基于 ROS-TaskMaster v2.1 + 现有扫描器 + Benchmark 框架

set -o pipefail

# ========== 路径配置 ==========
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCANNER_BASE="/home/cdy/.openclaw/workspace/agent-security-skill-scanner-master"
readonly BENCHMARK_BASE="/home/cdy/Desktop/security-benchmark"
readonly ROS_BASE="$SCRIPT_DIR/../research-orchestrator"

# 扫描器配置
readonly RULES_DIR="$SCANNER_BASE/output/rules"
readonly SAMPLES_DIR="$SCANNER_BASE/benchmark_samples"
readonly OUTPUT_DIR="$SCANNER_BASE/output"

mkdir -p "$OUTPUT_DIR"

# 颜色
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $(date '+%H:%M:%S') $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $(date '+%H:%M:%S') $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $(date '+%H:%M:%S') $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $(date '+%H:%M:%S') $*"; }
log_scan() { echo -e "${CYAN}[SCAN]${NC} $(date '+%H:%M:%S') $*"; }

# ========== 扫描模式 ==========
run_scan() {
    local target="$1"
    local mode="${2:-lite}"  # lite|full|distributed|deep
    local output_format="${3:-markdown}"  # markdown|json
    
    log_scan "========== Scanner Master v3.0 =========="
    log_info "扫描目标：$target"
    log_info "扫描模式：$mode"
    log_info "输出格式：$output_format"
    echo ""
    
    case "$mode" in
        lite)
            log_info "使用 ROS-Scanner v2 (YARA + Pattern)"
            python3 "$SCRIPT_DIR/ros-scanner-v2.py" "$target" --workers 4 2>&1
            ;;
        full)
            log_info "使用 ROS-Scanner v2 (完整扫描)"
            python3 "$SCRIPT_DIR/ros-scanner-v2.py" "$target" --workers 8 2>&1
            ;;
        distributed)
            log_info "使用 ROS-Scanner v2 (高并发)"
            python3 "$SCRIPT_DIR/ros-scanner-v2.py" "$target" --workers 16 2>&1
            ;;
        deep)
            log_info "使用深度扫描 (交叉验证)"
            run_deep_scan "$target"
            ;;
        benchmark)
            log_info "使用 Benchmark 模式 (完整测试)"
            python3 "$SCRIPT_DIR/ros-scanner-v2.py" "$target" --workers 8 2>&1
            ;;
        *)
            log_error "未知扫描模式：$mode"
            show_help
            return 1
            ;;
    esac
    
    local exit_code=$?
    
    if [ $exit_code -eq 0 ]; then
        log_success "扫描完成"
    else
        log_error "扫描失败 (退出码：$exit_code)"
    fi
    
    return $exit_code
}

# ========== 深度扫描 (带交叉验证) ==========
run_deep_scan() {
    local target="$1"
    
    log_info "深度扫描：多模型交叉验证"
    
    # 步骤 1: 初始扫描
    log_scan "步骤 1: 初始扫描"
    local initial_result=$(python3 "$SCANNER_BASE/scanner_lite_v3.py" "$target" 2>&1)
    echo "$initial_result"
    
    # 步骤 2: 提取威胁发现
    log_scan "步骤 2: 提取威胁发现"
    local threats=$(echo "$initial_result" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    threats = [t for t in data.get('findings', []) if t.get('verdict') == 'malicious']
    print(json.dumps({'threats': threats, 'count': len(threats)}))
except:
    print(json.dumps({'threats': [], 'count': 0}))
")
    
    local threat_count=$(echo "$threats" | python3 -c "import sys,json; print(json.load(sys.stdin)['count'])")
    
    if [ "$threat_count" -eq 0 ]; then
        log_success "未发现威胁"
        return 0
    fi
    
    log_warn "发现 $threat_count 个潜在威胁"
    
    # 步骤 3: 交叉验证
    log_scan "步骤 3: 交叉验证 (多模型)"
    
    # 调用 ROS 交叉验证
    source "$ROS_BASE/ros-taskmaster.sh" 2>/dev/null
    
    echo "$threats" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for i, threat in enumerate(data['threats'][:5], 1):  # 最多验证 5 个
    threat_id = threat.get('sample_id', f'threat_{i}')
    threat_desc = f\"发现威胁：{threat.get('attack_type', 'unknown')} in {threat_id}\"
    print(f'验证 {i}/5: {threat_id}')
    # 实际应调用 cross_validate 函数
    # cross_validate \"$threat_desc\" security review analysis
done
"
    
    # 步骤 4: 生成报告
    log_scan "步骤 4: 生成报告"
    local report_file="$OUTPUT_DIR/deep-scan-$(date +%Y%m%d_%H%M%S).md"
    
    cat > "$report_file" << EOF
# 深度扫描报告

**时间:** $(date)
**目标:** $target
**模式:** 深度扫描 + 交叉验证

## 扫描结果

\`\`\`
$initial_result
\`\`\`

## 威胁发现

威胁数量：$threat_count

## 交叉验证

详见输出日志

## 建议

- 审查所有标记为恶意的样本
- 对高置信度威胁优先处理
- 定期运行扫描保持安全
EOF
    
    log_success "报告已保存：$report_file"
}

# ========== Benchmark 测试 ==========
run_benchmark() {
    local suite="${1:-full}"  # full|quick|specific
    
    log_scan "========== Benchmark 测试 =========="
    log_info "测试套件：$suite"
    echo ""
    
    case "$suite" in
        full)
            log_info "运行完整 Benchmark"
            python3 "$BENCHMARK_BASE/run_benchmark_scanner.py" 2>&1
            ;;
        quick)
            log_info "运行快速 Benchmark"
            python3 "$SCANNER_BASE/benchmark_full_scan.py" --quick 2>&1
            ;;
        specific)
            log_info "运行特定测试"
            python3 "$BENCHMARK_BASE/run_benchmark.py" 2>&1
            ;;
        *)
            log_error "未知测试套件：$suite"
            return 1
            ;;
    esac
}

# ========== 规则管理 ==========
manage_rules() {
    local action="${1:-status}"  # status|optimize|validate|list
    
    log_scan "========== 规则管理 =========="
    log_info "操作：$action"
    echo ""
    
    case "$action" in
        status)
            log_info "规则状态"
            ls -la "$RULES_DIR"/*.yar 2>/dev/null | wc -l | xargs -I {} echo "规则文件数：{}"
            ;;
        optimize)
            log_info "优化规则"
            bash "$SCANNER_BASE/optimize_rules.sh" 2>&1
            ;;
        validate)
            log_info "验证规则"
            bash "$SCANNER_BASE/manage_rules.sh" validate 2>&1
            ;;
        list)
            log_info "规则列表"
            ls -1 "$RULES_DIR"/*.yar 2>/dev/null | head -20
            ;;
        *)
            log_error "未知操作：$action"
            return 1
            ;;
    esac
}

# ========== 样本管理 ==========
manage_samples() {
    local action="${1:-status}"  # status|generate|import|clean
    
    log_scan "========== 样本管理 =========="
    log_info "操作：$action"
    echo ""
    
    case "$action" in
        status)
            log_info "样本状态"
            ls -d "$SAMPLES_DIR"/*/ 2>/dev/null | wc -l | xargs -I {} echo "样本目录数：{}"
            find "$SAMPLES_DIR" -name "payload.*" 2>/dev/null | wc -l | xargs -I {} echo "样本文件数：{}"
            ;;
        generate)
            log_info "生成样本"
            python3 "$SCANNER_BASE/generators/sample_generator.py" 2>&1
            ;;
        import)
            log_info "导入样本"
            python3 "$BENCHMARK_BASE/import_existing_samples.py" 2>&1
            ;;
        clean)
            log_warn "清理样本 (谨慎操作)"
            read -p "确定要清理样本吗？[y/N] " -n 1 -r
            echo
            if [[ $REPLY =~ ^[Yy]$ ]]; then
                rm -rf "$SAMPLES_DIR"/generated_*
                log_success "已清理生成的样本"
            fi
            ;;
        *)
            log_error "未知操作：$action"
            return 1
            ;;
    esac
}

# ========== 质量门禁 ==========
quality_gate() {
    log_scan "========== 质量门禁 =========="
    
    bash "$SCANNER_BASE/quality_gate.sh" 2>&1
}

# ========== 使用说明 ==========
show_help() {
    cat << EOF
🛡️  Scanner Master v3.0 - 统一安全扫描入口

用法：scan <命令> [选项]

扫描命令:
  scan <目标> [模式]              执行扫描 (lite|full|distributed|deep)
  scan benchmark [套件]           运行 Benchmark (full|quick|specific)
  scan rules [操作]               规则管理 (status|optimize|validate|list)
  scan samples [操作]             样本管理 (status|generate|import|clean)
  scan quality                    质量门禁检查
  scan help                       显示帮助

扫描模式:
  lite         快速扫描 (YARA + 意图识别)
  full         完整扫描 (所有规则 + 报告)
  distributed  分布式扫描 (多进程并发)
  deep         深度扫描 (多模型交叉验证)

示例:
  scan /path/to/code lite                    # 快速扫描
  scan /path/to/code deep                    # 深度扫描 + 交叉验证
  scan benchmark full                        # 完整 Benchmark 测试
  scan rules optimize                        # 优化规则
  scan samples status                        # 查看样本状态
  scan quality                               # 质量门禁检查

输出:
  扫描结果保存在：$OUTPUT_DIR/
  Benchmark 报告：$SCANNER_BASE/benchmark/

集成能力:
  - 基于 ROS-TaskMaster v2.1 编排
  - 复用现有扫描器 (lite/distributed/hybrid)
  - 集成 security-benchmark 样本库
  - 支持交叉验证降低误报率
EOF
}

# ========== 主入口 ==========
case "${1:-help}" in
    scan)
        shift
        run_scan "$@"
        ;;
    benchmark)
        shift
        run_benchmark "$@"
        ;;
    rules)
        shift
        manage_rules "$@"
        ;;
    samples)
        shift
        manage_samples "$@"
        ;;
    quality)
        quality_gate
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        # 默认当作 scan 命令
        if [ -e "$1" ]; then
            run_scan "$@"
        else
            show_help
            exit 1
        fi
        ;;
esac
