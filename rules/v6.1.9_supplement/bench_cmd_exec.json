{
  "name": "Benchmark Rules - Command Execution",
  "version": "1.0",
  "created_at": "2026-04-21",
  "rules": [
    {
      "id": "BENCH-016",
      "name": "命令执行 - eval 执行",
      "category": "command_injection",
      "patterns": [
        "eval\\s*\\([^)]*(input|\\$)"
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    },
    {
      "id": "BENCH-017",
      "name": "命令执行 - exec 执行",
      "category": "command_injection",
      "patterns": [
        "exec\\s*\\([^)]*(input|os\\.|subprocess\\.)"
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    },
    {
      "id": "BENCH-018",
      "name": "命令执行 - os.system",
      "category": "command_injection",
      "patterns": [
        "os\\.system\\s*\\("
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    },
    {
      "id": "BENCH-019",
      "name": "命令执行 - subprocess shell",
      "category": "command_injection",
      "patterns": [
        "subprocess\\.(call|run|Popen).*shell\\s*=\\s*True"
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    },
    {
      "id": "BENCH-020",
      "name": "命令执行 - os.popen",
      "category": "command_injection",
      "patterns": [
        "os\\.popen\\s*\\("
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    },
    {
      "id": "BENCH-021",
      "name": "命令执行 - __import__ os",
      "category": "command_injection",
      "patterns": [
        "__import__\\s*\\(\\s*[\\'\"]os[\\'\"]\\s*\\)"
      ],
      "min_matches": 1,
      "confidence": 95,
      "severity": "critical"
    }
  ]
}