{
  "name": "Benchmark Rules - Data Exfiltration",
  "version": "1.0",
  "created_at": "2026-04-21",
  "rules": [
    {
      "id": "BENCH-016",
      "name": "数据外传 - requests.put/patch",
      "category": "data_exfiltration",
      "patterns": [
        "requests\\.(put|patch)\\([^)]*(attacker|evil)"
      ],
      "min_matches": 1,
      "confidence": 90,
      "severity": "critical"
    },
