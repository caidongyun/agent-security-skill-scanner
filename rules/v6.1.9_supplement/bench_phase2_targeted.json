{
  "name": "Phase 2 - Targeted Rules",
  "version": "1.0",
  "created_at": "2026-04-21",
  "description": "基于实际样本内容生成的针对性规则",
  "rules": [
    {
      "id": "BENCH-075",
      "name": "Phase2 - ignore previous",
      "category": "prompt_injection",
      "patterns": [
        "ignore\\s+(all\\s+)?(previous|your)?\\s*(instructions|rules|filters)"
      ],
      "min_matches": 1,
      "confidence": 90,
      "severity": "high"
    },
    {
      "id": "BENCH-076",
      "name": "Phase2 - disregard safety",
      "category": "prompt_injection",
