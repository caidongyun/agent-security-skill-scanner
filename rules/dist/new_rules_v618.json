        "process\\.env",
        "\\.get\\s*\\(\\s*[\"']API_KEY",
        "\\.get\\s*\\(\\s*[\"']SECRET",
        "\\.get\\s*\\(\\s*[\"']PASSWORD",
        "keyring\\.get\\s*\\("
      ],
      "min_matches": 1,
      "confidence": 80,
      "source": "clawhub_v618_analysis",
      "severity": "CRITICAL",
      "description": "访问凭据存储，可能窃取密钥",
      "ast_check": false,
      "risk_type": "credential_access"
    },
    {
      "id": "NEW-003",
      "name": "Dangerous Code Execution",
