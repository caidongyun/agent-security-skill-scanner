        "\\bexec\\s*\\([^)]*\\)",
        "subprocess\\.call\\s*\\(",
        "subprocess\\.run\\s*\\([^,]+shell\\s*=\\s*True",
        "os\\.system\\s*\\(",
        "os\\.popen\\s*\\(",
        "compile\\s*\\([^)]*\\)",
        "Function\\s*\\([^)]*\\)",
        "new\\s+Function\\s*\\("
      ],
      "min_matches": 1,
      "confidence": 90,
      "source": "clawhub_v618_analysis",
      "severity": "CRITICAL",
      "description": "危险代码执行，可能导致命令注入",
      "ast_check": true,
      "risk_type": "code_execution"
    },
    {
