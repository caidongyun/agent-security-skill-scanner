  "rules": [
    {
      "id": "NEW-001",
      "name": "Dynamic External Code Load",
      "category": "supply_chain",
      "patterns": [
        "fetch\\s*\\(\\s*[\"']http",
        "fetch\\s*\\(\\s*['\"]http",
        "loadScript\\s*\\(",
        "import\\s*\\(\\s*[\"']http",
        "\\$get\\s*\\(\\s*[\"']http",
        "\\$post\\s*\\(\\s*[\"']http"
      ],
      "min_matches": 1,
      "confidence": 85,
      "source": "clawhub_v618_analysis",
      "severity": "CRITICAL",
      "description": "动态加载外部代码，可能是供应链攻击",
      "ast_check": false,
      "risk_type": "dynamic_load"
    },
    {
      "id": "NEW-002",
      "name": "Credential Access via Environment",
      "category": "credential_theft",
      "patterns": [
